<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 自定义入口（Program.Main）以便 --statusline 助手在不启动 WPF 的情况下快进快出 -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>ClaudeNotch.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClaudeNotch</AssemblyName>
    <RootNamespace>ClaudeNotch</RootNamespace>
    <Product>ClaudeNotch</Product>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内置 LiteLLM 价表快照（与 macOS 版同一份，构建时从 ../../macos 拷入由 CI 处理，亦可手动放置） -->
    <None Include="Assets\litellm_prices.json" Condition="Exists('Assets\litellm_prices.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
