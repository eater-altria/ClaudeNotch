<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 自定义入口（Program.Main）以便 statusline 助手在不启动 WPF 的情况下快进快出 -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>ClaudeNotch.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClaudeNotch</AssemblyName>
    <RootNamespace>ClaudeNotch</RootNamespace>
    <Product>ClaudeNotch</Product>
    <Version>1.5.1</Version>
    <AssemblyVersion>1.5.1.0</AssemblyVersion>
    <FileVersion>1.5.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 为主：移除 WinForms/Drawing 的隐式 global using，避免 Button/ComboBox/Application/Color 与 WPF 同名冲突。
         托盘文件 UI/Tray.cs 显式 using System.Windows.Forms / System.Drawing。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- 该 WPF/WinForms 工程的隐式 using 不含 System.IO，显式补上（File/Path/Directory 等） -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置 LiteLLM 价表快照（与 macOS 版同一份，构建时从 ../../macos 拷入由 CI 处理，亦可手动放置） -->
    <None Include="Assets\litellm_prices.json" Condition="Exists('Assets\litellm_prices.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
