<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClaudeNotch</RootNamespace>
    <AssemblyName>ClaudeNotch</AssemblyName>

    <!-- WinUI 3 / Windows App SDK -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- 非打包(unpackaged) + 自包含(.NET 运行时 + WinAppSDK 原生运行时一并打包) -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- WinUI 3 无 AnyCPU,必须钉死平台/RID -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      ⚠️ unpackaged + 自包含的关键:app 的 PRI 必须叫 resources.pri。
      默认 MSBuild 把它命名为 <AssemblyName>.pri(=ClaudeNotch.pri),而 unpackaged
      资源加载器只认 exe 旁的 resources.pri → ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml
      无法解析 → new XamlControlsResources() 直接 COMException 闪退。
      参见 microsoft-ui-xaml#10856。
    -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>

    <!-- 自定义入口 Program.Main:让 statusline 钩子在不起 UI 的情况下快进快出 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>ClaudeNotch.Program</StartupObject>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Product>ClaudeNotch</Product>
    <Version>2.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260208005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <!-- 2.2.0 是支持 net8 的最高版(2.3+ 仅 net10);支持 net8.0-windows10.0.17763,兼容本工程 19041 -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用 WPF 工程里的 Core 业务逻辑层(与 UI 框架解耦,零改动链接编译) -->
    <Compile Include="..\ClaudeNotch\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 内置 LiteLLM 价表快照(与 macOS / WPF 版同一份;CI 拷入或手动放置) -->
    <Content Include="Assets\litellm_prices.json" Condition="Exists('Assets\litellm_prices.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
